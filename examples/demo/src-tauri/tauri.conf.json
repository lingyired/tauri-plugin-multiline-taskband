{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "multiline-taskband-demo",
  "version": "0.1.0",
  "identifier": "com.tauri.multiline-taskband-demo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multiline Taskband Demo",
        "width": 880,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
